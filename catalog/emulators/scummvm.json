{
  "id": "scummvm",
  "name": "ScummVM",
  "platforms": [
    "scummvm"
  ],
  "license": "GPL-3.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.scummvm.ScummVM"
    },
    "windows": {
      "url": "https://downloads.scummvm.org/frs/scummvm/2026.3.0/scummvm-2026.3.0-win32-x86_64.zip",
      "version": "2026.3.0",
      "exe": "scummvm.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "scummvm"
      ],
      "flatpak": "org.scummvm.ScummVM"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\ScummVM\\scummvm.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.scummvm.ScummVM/config/scummvm",
    "native": "~/.config/scummvm",
    "portable": "<app>",
    "windows": "%APPDATA%\\ScummVM"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "--auto-detect",
      "-p",
      "{file}"
    ]
  },
  "notes": "Launches a game directory, not a file."
}
