{
  "$defs": {
    "Also": {
      "additionalProperties": false,
      "description": "A key written alongside a knob. `value` is a literal, with `{value}` standing for the\nknob's own rendered value; `bool` and `values` spell the knob's neutral value for this key.",
      "properties": {
        "bool": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "file": {
          "description": "Another file name; the knob's own by default.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "section": {
          "description": "Another section; the knob's own by default.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "AssetFilter": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "all": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "none": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "all"
          ],
          "type": "object"
        }
      ],
      "description": "Which release asset: a fixed name, or substrings that must all appear and none that may."
    },
    "Binding": {
      "additionalProperties": false,
      "description": "One knob bound to one key, with the spelling the emulator expects. Exactly one of `bool`,\n`values` and `scale` is present, by the knob's type: `bool` for `video.fullscreen` and\n`video.vsync`, `values` for `video.aspect` and `region`, `scale` for `video.scale`.",
      "properties": {
        "also": {
          "description": "Keys written alongside every write of this knob (the renderer a scale needs, a second\naxis, a mode string beside a flag).",
          "items": {
            "$ref": "#/$defs/Also"
          },
          "type": "array"
        },
        "bool": {
          "description": "`[true, false]` as the emulator spells them (`True`/`False`, `1`/`0`, `yes`/`no`).",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "file": {
          "description": "A name from `files`.",
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "note": {
          "description": "A caveat that makes the knob partial: it is written, and this is what to know.",
          "type": [
            "string",
            "null"
          ]
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scale"
            },
            {
              "type": "null"
            }
          ]
        },
        "section": {
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Neutral value → the emulator's literal, quotes included where its format wants them.\nA neutral value missing here is unsupported, and says so.",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "file",
        "key"
      ],
      "type": "object"
    },
    "Channel": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "`flatpak install --user flathub <id>`.",
          "properties": {
            "flatpak": {
              "type": "string"
            }
          },
          "required": [
            "flatpak"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The latest GitHub release of `owner/repo`, one asset of it, extracted into the prefix.",
          "properties": {
            "asset": {
              "$ref": "#/$defs/AssetFilter"
            },
            "exe": {
              "description": "Path of the executable inside the extracted tree.",
              "type": "string"
            },
            "github": {
              "type": "string"
            },
            "portable": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Portable"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "github",
            "asset",
            "exe"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fixed URL, for projects without GitHub releases. Bumped by catalog PRs.",
          "properties": {
            "exe": {
              "type": "string"
            },
            "portable": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Portable"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "description": "Hex sha256 of the file when the project publishes one; otherwise hermir records the\ndigest it saw and says so.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "version",
            "exe"
          ],
          "type": "object"
        }
      ],
      "description": "One way to obtain the emulator on one OS."
    },
    "Config": {
      "additionalProperties": false,
      "description": "What `apply` may write into a copy, as the catalog describes it: data, so an emulator with\nplain `key = value` settings needs no code at all.",
      "properties": {
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigFile"
          },
          "description": "Named files under the config root. Knobs, adapters and `Patch::native` refer to them\nby name; `main` is the conventional name of the settings file.",
          "type": "object"
        },
        "knobs": {
          "additionalProperties": {
            "$ref": "#/$defs/Knob"
          },
          "description": "Knob → where it lands, or why it cannot. The knobs are [`KNOBS`]; one not listed here\nis reported as not described.",
          "type": "object"
        },
        "players": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayersSupport"
            },
            {
              "type": "null"
            }
          ],
          "description": "How player bindings are written. Absent: not described."
        }
      },
      "type": "object"
    },
    "ConfigFile": {
      "additionalProperties": false,
      "description": "One settings file of an emulator.",
      "properties": {
        "format": {
          "$ref": "#/$defs/Format"
        },
        "path": {
          "$ref": "#/$defs/FilePath",
          "description": "Relative to the config root, for every OS or per OS where the layout differs.\n`{config}/` at the start is the settings directory beside a data root: `~/.config/<x>`\nfor `~/.local/share/<x>`, a Flatpak's `config/<x>` for its `data/<x>`, the root itself\nelsewhere."
        },
        "root": {
          "description": "XML: the document element the keys hang off (Cemu's `content`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "format"
      ],
      "type": "object"
    },
    "Detect": {
      "additionalProperties": false,
      "description": "Detection rules for one OS. Every list is tried; every hit is an `Install`.",
      "properties": {
        "flatpak": {
          "description": "A Flathub app id, looked for in the user and system installations.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Program names looked up on `PATH`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "description": "Absolute paths of the executable, with `~`, `%VAR%` and `$VAR`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "portable_marker": {
          "description": "A file beside the exe that marks a portable install.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FilePath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/PerOs4"
        }
      ],
      "description": "A path for every OS, or one per OS."
    },
    "Firmware": {
      "additionalProperties": false,
      "description": "Firmware the emulator reads from a folder under its config root, or installs itself.",
      "properties": {
        "dir": {
          "description": "Relative to the config root: `bios`, `system`, `data`, or `.` for the root itself.\nAbsent when the emulator only takes firmware through its own installer.",
          "type": [
            "string",
            "null"
          ]
        },
        "install": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirmwareInstall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The emulator's own installer, for firmware that is not loose files."
        },
        "platforms": {
          "additionalProperties": {
            "$ref": "#/$defs/FirmwareNeed"
          },
          "default": {},
          "description": "Per platform id: what satisfies it.",
          "type": "object"
        },
        "unpack": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirmwareUnpack"
            },
            {
              "type": "null"
            }
          ],
          "description": "Firmware that comes as an archive, unpacked into a folder of its own."
        }
      },
      "type": "object"
    },
    "FirmwareInstall": {
      "additionalProperties": false,
      "description": "Firmware the emulator installs from one file (RPCS3's `--installfw <PUP>`).",
      "properties": {
        "args": {
          "description": "The argv after the exe; `{file}` is the firmware file.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "done": {
          "description": "A file under the config root that exists once firmware is installed. It, not the exit\ncode, says whether the install worked.",
          "type": "string"
        }
      },
      "required": [
        "args",
        "done"
      ],
      "type": "object"
    },
    "FirmwareNeed": {
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "description": "File name patterns (`*.bin`, `scph*.bin`); one match is enough.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "description": "Where the files come from, in a phrase a UI can show.",
          "type": [
            "string",
            "null"
          ]
        },
        "optional": {
          "description": "The emulator also runs without it (an HLE BIOS); its absence is no failure.",
          "type": "boolean"
        }
      },
      "required": [
        "any_of"
      ],
      "type": "object"
    },
    "FirmwareUnpack": {
      "additionalProperties": false,
      "description": "An archive of firmware files (a Switch system update as a `.zip` of NCAs), unpacked once.",
      "properties": {
        "any_of": {
          "description": "Archive names (`*.zip`). A match is unpacked, never copied into `dir`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "into": {
          "description": "Relative to the config root: where the archive's files go.",
          "type": "string"
        },
        "present": {
          "description": "A name pattern that, found in `into`, means firmware is installed. Nothing is unpacked\nover it, so firmware the player installed stays.",
          "type": "string"
        }
      },
      "required": [
        "any_of",
        "into",
        "present"
      ],
      "type": "object"
    },
    "FirstRun": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "`key` in `[section]` of an ini (or flat TOML) file, set to `value` in place. The file and\nsection are created when missing; every other line stays as it was. `{root}` in `value`\nis the config root's absolute path.",
          "properties": {
            "ini": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "when_unset": {
              "description": "Only when the key is missing or empty: a value the user chose is kept.",
              "type": "boolean"
            }
          },
          "required": [
            "ini",
            "section",
            "key",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file written only when it does not exist yet: the emulator's own first-run check.",
          "properties": {
            "content": {
              "type": "string"
            },
            "seed": {
              "type": "string"
            }
          },
          "required": [
            "seed",
            "content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A folder under the config root that must exist before the emulator writes into it.",
          "properties": {
            "dir": {
              "type": "string"
            }
          },
          "required": [
            "dir"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file the emulator ships beside its exe, copied under the config root once (data an\nemulator refuses to start without). Only a copy hermir placed has an exe to copy from.",
          "properties": {
            "copy": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "copy",
            "to"
          ],
          "type": "object"
        }
      ],
      "description": "One answer to a first-run question, as a file under the config root."
    },
    "Format": {
      "description": "How a settings file is patched. Each is a line editor that leaves everything else alone.",
      "oneOf": [
        {
          "const": "ini",
          "description": "`key = value` under `[section]`: ini, flat TOML, RetroArch's cfg. An empty section is\nthe top of the file.",
          "type": "string"
        },
        {
          "const": "qt",
          "description": "Qt's ini: every key written gets its `key\\default=false` companion, or Qt ignores it.",
          "type": "string"
        },
        {
          "const": "yaml",
          "description": "Two-level YAML: `Section:` then `  Key: value`; an empty section is the top level.",
          "type": "string"
        },
        {
          "const": "bml",
          "description": "ares's BML: `Section` then `  Key: value`.",
          "type": "string"
        },
        {
          "const": "xml",
          "description": "Elements by path under the file's `root`; `section` is the path between root and key,\n`/`-separated, empty for a child of the root.",
          "type": "string"
        },
        {
          "const": "json",
          "description": "Top-level keys of one object; `section` is unused.",
          "type": "string"
        }
      ]
    },
    "Knob": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "The emulator has no such setting; the note is what a UI shows.",
          "properties": {
            "unsupported": {
              "type": "string"
            }
          },
          "required": [
            "unsupported"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Binding"
        }
      ],
      "description": "Where a neutral knob lands in an emulator's files, or why it cannot."
    },
    "Launch": {
      "additionalProperties": false,
      "description": "The argv template after the exe. `{file}` is the game, `{fullscreen:-f}` expands to `-f`\nwhen fullscreen is asked for. Rendered in P1; carried as data now.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PerOs": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "PerOs2": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detect"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detect"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detect"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "PerOs3": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "items": {
            "$ref": "#/$defs/FirstRun"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "macos": {
          "items": {
            "$ref": "#/$defs/FirstRun"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/FirstRun"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PerOs4": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "type": [
            "string",
            "null"
          ]
        },
        "macos": {
          "type": [
            "string",
            "null"
          ]
        },
        "windows": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PlayersSupport": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "A Rust adapter writes them: `crates/hermir/src/config/adapters/<adapter>.rs`.",
          "properties": {
            "adapter": {
              "type": "string"
            }
          },
          "required": [
            "adapter"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The emulator picks up SDL pads itself, in the order they appear; there is nothing to\nwrite. The note says so in the emulator's terms.",
          "properties": {
            "automatic": {
              "type": "string"
            }
          },
          "required": [
            "automatic"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "unsupported": {
              "type": "string"
            }
          },
          "required": [
            "unsupported"
          ],
          "type": "object"
        }
      ],
      "description": "How an emulator's player bindings come to be."
    },
    "Portable": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dir": {
              "type": "string"
            }
          },
          "required": [
            "dir"
          ],
          "type": "object"
        }
      ],
      "description": "What makes the emulator keep its files beside the exe: a marker file or a directory."
    },
    "Roots": {
      "additionalProperties": false,
      "description": "Config root per install kind.",
      "properties": {
        "flatpak": {
          "type": [
            "string",
            "null"
          ]
        },
        "native": {
          "type": [
            "string",
            "null"
          ]
        },
        "portable": {
          "type": [
            "string",
            "null"
          ]
        },
        "windows": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Scale": {
      "description": "How `video.scale`, a multiplier `n` of the console's resolution, is spelled.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`n` itself, `min..=max`.",
          "properties": {
            "multiplier": {
              "properties": {
                "max": {
                  "default": 8,
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "min": {
                  "default": 1,
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "multiplier"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`n × 100`, a percentage of the console's resolution (RPCS3).",
          "properties": {
            "percent": {
              "properties": {
                "max": {
                  "default": 8,
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "min": {
                  "default": 1,
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "percent"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`n × base`, vertical lines (Flycast's 480).",
          "properties": {
            "lines": {
              "properties": {
                "base": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "max": {
                  "default": 8,
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "base"
              ],
              "type": "object"
            }
          },
          "required": [
            "lines"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`n` (as a decimal string, JSON's key) → the emulator's own value; an `n` missing here\nis unsupported.",
          "properties": {
            "map": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "map"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A catalog entry: one emulator, as `catalog/emulators/<id>.json` spells it.",
  "properties": {
    "channels": {
      "$ref": "#/$defs/PerOs",
      "default": {},
      "description": "Where to get it, per OS. Empty means detect-and-configure only."
    },
    "config": {
      "anyOf": [
        {
          "$ref": "#/$defs/Config"
        },
        {
          "type": "null"
        }
