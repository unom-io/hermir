{
  "$defs": {
    "AssetFilter": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "all": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "none": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "all"
          ],
          "type": "object"
        }
      ],
      "description": "Which release asset: a fixed name, or substrings that must all appear and none that may."
    },
    "Channel": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "`flatpak install --user flathub <id>`.",
          "properties": {
            "flatpak": {
              "type": "string"
            }
          },
          "required": [
            "flatpak"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The latest GitHub release of `owner/repo`, one asset of it, extracted into the prefix.",
          "properties": {
            "asset": {
              "$ref": "#/$defs/AssetFilter"
            },
            "exe": {
              "description": "Path of the executable inside the extracted tree.",
              "type": "string"
            },
            "github": {
              "type": "string"
            },
            "portable": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Portable"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "github",
            "asset",
            "exe"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fixed URL, for projects without GitHub releases. Bumped by catalog PRs.",
          "properties": {
            "exe": {
              "type": "string"
            },
            "portable": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Portable"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "description": "Hex sha256 of the file when the project publishes one; otherwise hermir records the\ndigest it saw and says so.",
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "version",
            "exe"
          ],
          "type": "object"
        }
      ],
      "description": "One way to obtain the emulator on one OS."
    },
    "Detect": {
      "additionalProperties": false,
      "description": "Detection rules for one OS. Every list is tried; every hit is an `Install`.",
      "properties": {
        "flatpak": {
          "description": "A Flathub app id, looked for in the user and system installations.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Program names looked up on `PATH`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "description": "Absolute paths of the executable, with `~`, `%VAR%` and `$VAR`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "portable_marker": {
          "description": "A file beside the exe that marks a portable install.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Firmware": {
      "additionalProperties": false,
      "description": "Firmware the emulator reads from a folder under its config root, or installs itself.",
      "properties": {
        "dir": {
          "description": "Relative to the config root: `bios`, `system`, `data`, or `.` for the root itself.\nAbsent when the emulator only takes firmware through its own installer.",
          "type": [
            "string",
            "null"
          ]
        },
        "install": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirmwareInstall"
            },
            {
              "type": "null"
            }
          ],
          "description": "The emulator's own installer, for firmware that is not loose files."
        },
        "platforms": {
          "additionalProperties": {
            "$ref": "#/$defs/FirmwareNeed"
          },
          "default": {},
          "description": "Per platform id: what satisfies it.",
          "type": "object"
        },
        "unpack": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirmwareUnpack"
            },
            {
              "type": "null"
            }
          ],
          "description": "Firmware that comes as an archive, unpacked into a folder of its own."
        }
      },
      "type": "object"
    },
    "FirmwareInstall": {
      "additionalProperties": false,
      "description": "Firmware the emulator installs from one file (RPCS3's `--installfw <PUP>`).",
      "properties": {
        "args": {
          "description": "The argv after the exe; `{file}` is the firmware file.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "done": {
          "description": "A file under the config root that exists once firmware is installed. It, not the exit\ncode, says whether the install worked.",
          "type": "string"
        }
      },
      "required": [
        "args",
        "done"
      ],
      "type": "object"
    },
    "FirmwareNeed": {
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "description": "File name patterns (`*.bin`, `scph*.bin`); one match is enough.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "description": "Where the files come from, in a phrase a UI can show.",
          "type": [
            "string",
            "null"
          ]
        },
        "optional": {
          "description": "The emulator also runs without it (an HLE BIOS); its absence is no failure.",
          "type": "boolean"
        }
      },
      "required": [
        "any_of"
      ],
      "type": "object"
    },
    "FirmwareUnpack": {
      "additionalProperties": false,
      "description": "An archive of firmware files (a Switch system update as a `.zip` of NCAs), unpacked once.",
      "properties": {
        "any_of": {
          "description": "Archive names (`*.zip`). A match is unpacked, never copied into `dir`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "into": {
          "description": "Relative to the config root: where the archive's files go.",
          "type": "string"
        },
        "present": {
          "description": "A name pattern that, found in `into`, means firmware is installed. Nothing is unpacked\nover it, so firmware the player installed stays.",
          "type": "string"
        }
      },
      "required": [
        "any_of",
        "into",
        "present"
      ],
      "type": "object"
    },
    "FirstRun": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "`key` in `[section]` of an ini (or flat TOML) file, set to `value` in place. The file and\nsection are created when missing; every other line stays as it was. `{root}` in `value`\nis the config root's absolute path.",
          "properties": {
            "ini": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "section": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "when_unset": {
              "description": "Only when the key is missing or empty: a value the user chose is kept.",
              "type": "boolean"
            }
          },
          "required": [
            "ini",
            "section",
            "key",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file written only when it does not exist yet: the emulator's own first-run check.",
          "properties": {
            "content": {
              "type": "string"
            },
            "seed": {
              "type": "string"
            }
          },
          "required": [
            "seed",
            "content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A folder under the config root that must exist before the emulator writes into it.",
          "properties": {
            "dir": {
              "type": "string"
            }
          },
          "required": [
            "dir"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A file the emulator ships beside its exe, copied under the config root once (data an\nemulator refuses to start without). Only a copy hermir placed has an exe to copy from.",
          "properties": {
            "copy": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "copy",
            "to"
          ],
          "type": "object"
        }
      ],
      "description": "One answer to a first-run question, as a file under the config root."
    },
    "Launch": {
      "additionalProperties": false,
      "description": "The argv template after the exe. `{file}` is the game, `{fullscreen:-f}` expands to `-f`\nwhen fullscreen is asked for. Rendered in P1; carried as data now.",
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PerOs": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/Channel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "PerOs2": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detect"
            },
            {
              "type": "null"
            }
          ]
        },
        "macos": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detect"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detect"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "PerOs3": {
      "additionalProperties": false,
      "description": "One slot per OS. A missing key is `None`: honest \"not offered here\".",
      "properties": {
        "linux": {
          "items": {
            "$ref": "#/$defs/FirstRun"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "macos": {
          "items": {
            "$ref": "#/$defs/FirstRun"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/FirstRun"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Portable": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dir": {
              "type": "string"
            }
          },
          "required": [
            "dir"
          ],
          "type": "object"
        }
      ],
      "description": "What makes the emulator keep its files beside the exe: a marker file or a directory."
    },
    "Roots": {
      "additionalProperties": false,
      "description": "Config root per install kind.",
      "properties": {
        "flatpak": {
          "type": [
            "string",
            "null"
          ]
        },
        "native": {
          "type": [
            "string",
            "null"
          ]
        },
        "portable": {
          "type": [
            "string",
            "null"
          ]
        },
        "windows": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A catalog entry: one emulator, as `catalog/emulators/<id>.json` spells it.",
  "properties": {
    "channels": {
      "$ref": "#/$defs/PerOs",
      "default": {},
      "description": "Where to get it, per OS. Empty means detect-and-configure only."
    },
    "detect": {
      "$ref": "#/$defs/PerOs2",
      "default": {},
      "description": "How to find a copy the user installed, per OS."
    },
    "firmware": {
      "anyOf": [
        {
          "$ref": "#/$defs/Firmware"
        },
        {
          "type": "null"
        }
      ],
      "description": "Where the emulator reads firmware, and what each platform needs there. The folder is\ncreated at install, so a consumer can be granted exactly that one."
    },
    "first_run": {
      "$ref": "#/$defs/PerOs3",
      "default": {},
      "description": "The answers to what a fresh copy asks before it plays anything (a setup wizard, a\nwelcome box), per OS. `prepare` writes them; each one is what clicking through writes."
    },
    "id": {
      "description": "Lowercase, `[a-z0-9-]`, equal to the file name.",
      "type": "string"
    },
    "launch": {
      "$ref": "#/$defs/Launch"
    },
    "license": {
      "description": "SPDX expression of the emulator's own licence.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "no_install": {
      "description": "Why this entry carries no install channel, when that is deliberate.",
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "platforms": {
      "description": "Platform ids from `catalog/platforms.json`.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "roots": {
      "$ref": "#/$defs/Roots",
      "default": {},
      "description": "Where the emulator keeps its config and data, per install kind. `<app>` is the exe's\ndirectory, `~` the home, `%VAR%` and `$VAR` environment variables."
    }
  },
  "required": [
    "id",
    "name",
    "platforms",
    "license",
    "launch"
  ],
  "title": "Entry",
  "type": "object"
}
