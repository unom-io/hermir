{
  "id": "eden",
  "name": "Eden",
  "platforms": [
    "switch"
  ],
  "license": "GPL-3.0-or-later",
  "no_install": "Switch emulators are never installed by hermir. A copy you installed is detected and configured like any other.",
  "detect": {
    "linux": {
      "path": [
        "eden"
      ],
      "flatpak": "dev.eden_emu.eden"
    },
    "windows": {
      "paths": [
        "%USERPROFILE%\\scoop\\apps\\eden\\current\\eden.exe"
      ],
      "portable_marker": "user"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/dev.eden_emu.eden/data/eden",
    "native": "~/.local/share/eden",
    "portable": "<app>/user",
    "windows": "%APPDATA%\\eden"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "-g",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": {
          "linux": "{config}/qt-config.ini",
          "windows": "config/qt-config.ini"
        },
        "format": "qt"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "UI",
        "key": "fullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "Renderer",
        "key": "resolution_setup",
        "scale": {
          "map": {
            "1": "2",
            "2": "4",
            "3": "5",
            "4": "6",
            "5": "7",
            "6": "8",
            "7": "9",
            "8": "10"
          }
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "Renderer",
        "key": "vsync_mode",
        "bool": [
          "2",
          "0"
        ],
        "note": "FIFO for on, immediate for off"
      },
      "video.aspect": {
        "file": "main",
        "section": "Renderer",
        "key": "aspect_ratio",
        "values": {
          "auto": "0",
          "16:9": "0",
          "4:3": "1",
          "stretch": "4"
        }
      },
      "region": {
        "file": "main",
        "section": "System",
        "key": "region_index",
        "values": {
          "auto": "-1",
          "jp": "0",
          "us": "1",
          "eu": "2"
        }
      }
    },
    "players": {
      "adapter": "eden"
    }
  },
  "saves": {
    "switch": [
      {
        "kind": "save",
        "path": "nand/user/save",
        "per_game": true,
        "note": "per user and title id: 0000000000000000/<user>/<title>"
      }
    ]
  },
  "notes": "The root is Eden's data folder, where keys and system firmware live; its settings are under ~/.config/eden. System firmware comes as a zip of NCAs and is unpacked only while none is installed.",
  "firmware": {
    "dir": "keys",
    "unpack": {
      "any_of": [
        "*.zip"
      ],
      "into": "nand/system/Contents/registered",
      "present": "*.nca"
    },
    "platforms": {
      "switch": {
        "any_of": [
          "prod.keys"
        ],
        "note": "prod.keys and title.keys, dumped from your Switch"
      }
    }
  }
}
