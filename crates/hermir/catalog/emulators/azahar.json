{
  "id": "azahar",
  "name": "Azahar",
  "platforms": [
    "3ds"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.azahar_emu.Azahar"
    },
    "windows": {
      "github": "azahar-emu/azahar",
      "asset": {
        "all": [
          "windows-msvc",
          ".zip"
        ],
        "none": [
          "installer",
          "libretro"
        ]
      },
      "exe": "azahar.exe",
      "portable": {
        "dir": "user"
      }
    },
    "macos": {
      "github": "azahar-emu/azahar",
      "asset": {
        "all": [
          "macos-universal",
          ".zip"
        ],
        "none": [
          "libretro"
        ]
      },
      "exe": "Azahar.app/Contents/MacOS/azahar"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "azahar"
      ],
      "flatpak": "org.azahar_emu.Azahar"
    },
    "windows": {
      "paths": [
        "%LOCALAPPDATA%\\Azahar\\azahar.exe"
      ],
      "portable_marker": "user"
    },
    "macos": {
      "paths": [
        "/Applications/Azahar.app/Contents/MacOS/azahar",
        "~/Applications/Azahar.app/Contents/MacOS/azahar"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.azahar_emu.Azahar/config/azahar-emu",
    "native": "~/.config/azahar-emu",
    "portable": "<app>/user",
    "windows": "%APPDATA%\\Azahar",
    "macos": "~/Library/Application Support/Azahar"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": {
          "linux": "qt-config.ini",
          "windows": "qt-config.ini",
          "macos": "config/qt-config.ini"
        },
        "format": "qt"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "UI",
        "key": "fullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "Renderer",
        "key": "resolution_factor",
        "scale": {
          "multiplier": {
            "max": 16
          }
        },
        "native": [
          400,
          480
        ],
        "native_by": {
          "section": "Layout",
          "key": "layout_option",
          "values": {
            "0": [
              400,
              480
            ],
            "1": [
              400,
              240
            ],
            "2": [
              480,
              240
            ],
            "3": [
              720,
              240
            ],
            "5": [
              577,
              240
            ]
          }
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "Renderer",
        "key": "use_vsync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "unsupported": "two screens; the layout is Layout/layout_option"
      },
      "region": {
        "file": "main",
        "section": "System",
        "key": "region_value",
        "values": {
          "auto": "-1",
          "jp": "0",
          "us": "1",
          "eu": "2"
        }
      }
    },
    "players": {
      "adapter": "azahar"
    }
  },
  "saves": {
    "3ds": [
      {
        "kind": "save",
        "path": "{data}/sdmc/Nintendo 3DS",
        "per_game": true,
        "note": "each title's data under the console's ids: <id0>/<id1>/title/<high>/<low>/data",
        "units": {
          "shape": "folders",
          "depth": 5,
          "keep": [
            "data/**"
          ]
        }
      },
      {
        "kind": "state",
        "path": "{data}/states",
        "per_game": true,
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "content": {
    "3ds": {
      "update": {
        "unsupported": "Azahar installs an update CIA through File → Install CIA"
      },
      "dlc": {
        "unsupported": "Azahar installs a DLC CIA through File → Install CIA"
      }
    }
  }
}
