{
  "id": "azahar",
  "name": "Azahar",
  "platforms": [
    "3ds"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.azahar_emu.Azahar"
    },
    "windows": {
      "github": "azahar-emu/azahar",
      "asset": {
        "all": [
          "windows-msvc",
          ".zip"
        ],
        "none": [
          "installer",
          "libretro"
        ]
      },
      "exe": "azahar.exe",
      "portable": {
        "dir": "user"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "azahar"
      ],
      "flatpak": "org.azahar_emu.Azahar"
    },
    "windows": {
      "paths": [
        "%LOCALAPPDATA%\\Azahar\\azahar.exe"
      ],
      "portable_marker": "user"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.azahar_emu.Azahar/config/azahar-emu",
    "native": "~/.config/azahar-emu",
    "portable": "<app>/user",
    "windows": "%APPDATA%\\Azahar"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "qt-config.ini",
        "format": "qt"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "UI",
        "key": "fullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "Renderer",
        "key": "resolution_factor",
        "scale": {
          "multiplier": {
            "max": 10
          }
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "Renderer",
        "key": "use_vsync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "unsupported": "two screens; the layout is Layout/layout_option"
      },
      "region": {
        "file": "main",
        "section": "System",
        "key": "region_value",
        "values": {
          "auto": "-1",
          "jp": "0",
          "us": "1",
          "eu": "2"
        }
      }
    },
    "players": {
      "adapter": "azahar"
    }
  },
  "saves": {
    "3ds": [
      {
        "kind": "save",
        "path": "{data}/sdmc/Nintendo 3DS",
        "per_game": true,
        "note": "each title's data under the console's ids: <id0>/<id1>/title/<high>/<low>/data"
      },
      {
        "kind": "state",
        "path": "{data}/states",
        "per_game": true
      }
    ]
  }
}
