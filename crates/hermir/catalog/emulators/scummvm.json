{
  "id": "scummvm",
  "name": "ScummVM",
  "platforms": [
    "scummvm"
  ],
  "license": "GPL-3.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.scummvm.ScummVM"
    },
    "windows": {
      "url": "https://downloads.scummvm.org/frs/scummvm/2026.3.0/scummvm-2026.3.0-win32-x86_64.zip",
      "version": "2026.3.0",
      "exe": "scummvm.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "scummvm"
      ],
      "flatpak": "org.scummvm.ScummVM"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\ScummVM\\scummvm.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.scummvm.ScummVM/config/scummvm",
    "native": "~/.config/scummvm",
    "portable": "<app>",
    "windows": "%APPDATA%\\ScummVM"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "--auto-detect",
      "-p",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "scummvm.ini",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "scummvm",
        "key": "fullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "unsupported": "the engines draw at the game's resolution"
      },
      "video.vsync": {
        "file": "main",
        "section": "scummvm",
        "key": "vsync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "scummvm",
        "key": "aspect_ratio",
        "values": {
          "auto": "false",
          "4:3": "true"
        },
        "note": "the 4:3 correction of 320×200 games"
      },
      "region": {
        "unsupported": "not a console"
      }
    },
    "players": {
      "unsupported": "keyboard and mouse games"
    }
  },
  "notes": "Launches a game directory, not a file."
}
