{
  "id": "mgba",
  "name": "mGBA",
  "platforms": [
    "gba",
    "gb",
    "gbc"
  ],
  "license": "MPL-2.0",
  "channels": {
    "linux": {
      "flatpak": "io.mgba.mGBA"
    },
    "windows": {
      "github": "mgba-emu/mgba",
      "asset": {
        "all": [
          "win64",
          ".7z"
        ],
        "none": [
          "installer"
        ]
      },
      "exe": "mGBA.exe",
      "portable": {
        "file": "portable.ini"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "mgba-qt",
        "mgba"
      ],
      "flatpak": "io.mgba.mGBA"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\mGBA\\mGBA.exe"
      ],
      "portable_marker": "portable.ini"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/io.mgba.mGBA/config/mgba",
    "native": "~/.config/mgba",
    "portable": "<app>",
    "windows": "%APPDATA%\\mGBA"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "config.ini",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "ports.qt",
        "key": "fullscreen",
        "bool": [
          "1",
          "0"
        ]
      },
      "video.scale": {
        "unsupported": "a 2D console; the Game Boy draws at one resolution"
      },
      "video.vsync": {
        "file": "main",
        "section": "ports.qt",
        "key": "videoSync",
        "bool": [
          "1",
          "0"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "ports.qt",
        "key": "lockAspectRatio",
        "values": {
          "auto": "1",
          "stretch": "0"
        }
      },
      "region": {
        "unsupported": "Game Boy games are region-free"
      }
    },
    "players": {
      "automatic": "mGBA maps SDL pads itself, in the order they appear"
    }
  }
}
