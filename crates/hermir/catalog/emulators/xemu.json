{
  "id": "xemu",
  "name": "xemu",
  "platforms": [
    "xbox"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "app.xemu.xemu"
    },
    "windows": {
      "github": "xemu-project/xemu",
      "asset": {
        "name": "xemu-win-x86_64-release.zip"
      },
      "exe": "xemu.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "xemu"
      ],
      "flatpak": "app.xemu.xemu"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\xemu\\xemu.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/app.xemu.xemu/data/xemu/xemu",
    "native": "~/.local/share/xemu/xemu",
    "portable": "<app>",
    "windows": "%APPDATA%\\xemu\\xemu"
  },
  "launch": {
    "args": [
      "{fullscreen:-full-screen}",
      "-dvd_path",
      "{file}"
    ]
  },
  "firmware": {
    "dir": "firmware",
    "keys": [
      {
        "ini": "xemu.toml",
        "section": "sys.files",
        "key": "bootrom_path",
        "any_of": [
          "mcpx*.bin"
        ],
        "value": "'{path}'",
        "note": "the MCPX boot ROM (mcpx_1.0.bin), dumped from an Xbox"
      },
      {
        "ini": "xemu.toml",
        "section": "sys.files",
        "key": "flashrom_path",
        "any_of": [
          "*.bin"
        ],
        "value": "'{path}'",
        "note": "a flash BIOS (Complex_4627.bin and the like), dumped from an Xbox"
      },
      {
        "ini": "xemu.toml",
        "section": "sys.files",
        "key": "hdd_path",
        "any_of": [
          "*.qcow2"
        ],
        "value": "'{path}'",
        "note": "a hard-disk image (xbox_hdd.qcow2)"
      }
    ],
    "platforms": {
      "xbox": {
        "any_of": [
          "mcpx*.bin",
          "*.bin",
          "*.qcow2"
        ],
        "note": "the MCPX boot ROM, a flash BIOS and a hard-disk image"
      }
    }
  },
  "config": {
    "files": {
      "main": {
        "path": "xemu.toml",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "display.window",
        "key": "fullscreen_on_startup",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "display.quality",
        "key": "surface_scale",
        "scale": {
          "multiplier": {
            "max": 10
          }
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "display.window",
        "key": "vsync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "display.ui",
        "key": "aspect_ratio",
        "values": {
          "auto": "\"auto\"",
          "4:3": "\"4x3\"",
          "16:9": "\"16x9\""
        },
        "note": "stretch is display.ui.fit, a native key"
      },
      "region": {
        "unsupported": "the EEPROM decides the region"
      }
    },
    "players": {
      "adapter": "xemu"
    }
  },
  "saves": {
    "xbox": [
      {
        "kind": "save",
        "setting": {
          "file": "main",
          "section": "sys.files",
          "key": "hdd_path"
        },
        "note": "inside the Xbox hard-disk image the player chose; none until one is set"
      }
    ]
  },
  "notes": "Needs an MCPX boot ROM, a flash BIOS and a hard-disk image the player provides: `prepare --firmware` copies them into firmware/ and points xemu.toml's [sys.files] keys at them."
}
