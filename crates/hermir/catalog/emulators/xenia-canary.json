{
  "id": "xenia-canary",
  "name": "Xenia Canary",
  "platforms": [
    "xbox360"
  ],
  "license": "BSD-3-Clause",
  "channels": {
    "linux": {
      "github": "xenia-canary/xenia-canary",
      "asset": {
        "all": [
          "xenia_canary_linux",
          ".AppImage"
        ]
      },
      "exe": "AppRun"
    },
    "windows": {
      "github": "xenia-canary/xenia-canary",
      "asset": {
        "all": [
          "xenia_canary_windows",
          ".7z"
        ]
      },
      "exe": "xenia_canary.exe",
      "portable": {
        "file": "portable.txt"
      }
    }
  },
  "detect": {
    "windows": {
      "portable_marker": "portable.txt"
    }
  },
  "roots": {
    "native": "~/.local/share/Xenia",
    "portable": "<app>",
    "windows": "%USERPROFILE%\\Documents\\Xenia"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen=true}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "xenia-canary.config.toml",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Display",
        "key": "fullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "GPU",
        "key": "draw_resolution_scale_x",
        "scale": {
          "multiplier": {
            "max": 3
          }
        },
        "also": [
          {
            "key": "draw_resolution_scale_y",
            "value": "{value}"
          }
        ]
      },
      "video.vsync": {
        "file": "main",
        "section": "GPU",
        "key": "vsync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "unsupported": "Xenia keeps the game's aspect"
      },
      "region": {
        "unsupported": "XConfig/user_country is a numeric country code; pass it through native"
      }
    },
    "players": {
      "automatic": "Xenia takes XInput pads in slot order"
    }
  },
  "saves": {
    "xbox360": [
      {
        "kind": "save",
        "path": "content",
        "per_game": true,
        "note": "per profile and title: content/<profile>/<title id>/00000001"
      }
    ]
  },
  "notes": "Linux gets Canary's own AppImage, unpacked; it outran the Windows build under Proton. The Windows build asks for a disclaimer once, remembered in HKCU\\SOFTWARE\\Xenia XEFLAGS."
}
