{
  "id": "xenia-canary",
  "name": "Xenia Canary",
  "platforms": [
    "xbox360"
  ],
  "license": "BSD-3-Clause",
  "channels": {
    "linux": {
      "github": "xenia-canary/xenia-canary",
      "asset": {
        "all": [
          "xenia_canary_linux",
          ".AppImage"
        ]
      },
      "exe": "AppRun"
    },
    "windows": {
      "github": "xenia-canary/xenia-canary",
      "asset": {
        "all": [
          "xenia_canary_windows",
          ".7z"
        ]
      },
      "exe": "xenia_canary.exe",
      "portable": {
        "file": "portable.txt"
      }
    }
  },
  "detect": {
    "windows": {
      "portable_marker": "portable.txt"
    }
  },
  "roots": {
    "native": "~/.local/share/Xenia",
    "portable": "<app>",
    "windows": "%USERPROFILE%\\Documents\\Xenia"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen=true}",
      "{file}"
    ]
  },
  "notes": "Linux gets Canary's own AppImage, unpacked; it outran the Windows build under Proton. The Windows build asks for a disclaimer once, remembered in HKCU\\SOFTWARE\\Xenia XEFLAGS."
}
