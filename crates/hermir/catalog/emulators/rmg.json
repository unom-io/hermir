{
  "id": "rmg",
  "name": "Rosalie's Mupen GUI",
  "platforms": [
    "n64"
  ],
  "license": "GPL-3.0-only",
  "channels": {
    "linux": {
      "flatpak": "com.github.Rosalie241.RMG"
    },
    "windows": {
      "github": "Rosalie241/RMG",
      "asset": {
        "all": [
          "Portable-Windows64",
          ".zip"
        ]
      },
      "exe": "RMG.exe",
      "portable": {
        "file": "portable.txt"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "RMG"
      ],
      "flatpak": "com.github.Rosalie241.RMG"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\RMG\\RMG.exe",
        "%LOCALAPPDATA%\\Programs\\RMG\\RMG.exe"
      ],
      "portable_marker": "portable.txt"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/com.github.Rosalie241.RMG/config/RMG",
    "native": "~/.config/RMG",
    "portable": "<app>/Config",
    "windows": "%APPDATA%\\RMG"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "mupen64plus.cfg",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Rosalie's Mupen GUI",
        "key": "AutomaticFullscreen",
        "bool": [
          "True",
          "False"
        ]
      },
      "video.scale": {
        "unsupported": "per video plugin in RMG (GLideN64 or ParaLLEl-RDP); pass it through native"
      },
      "video.vsync": {
        "unsupported": "per video plugin in RMG; pass it through native"
      },
      "video.aspect": {
        "unsupported": "per video plugin in RMG; pass it through native"
      },
      "region": {
        "unsupported": "the cartridge decides"
      }
    },
    "players": {
      "automatic": "RMG-Input takes the first pads itself, in the order they appear"
    }
  },
  "saves": {
    "n64": [
      {
        "kind": "save",
        "path": "{data}/Save/Game",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "Core",
          "key": "SaveSRAMPath"
        },
        "units": {
          "shape": "files"
        }
      },
      {
        "kind": "state",
        "path": "{data}/Save/State",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "Core",
          "key": "SaveStatePath"
        },
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "notes": "mupen64plus with GLideN64 and ParaLLEl behind a Qt front. The portable zip keeps Config/ beside the exe."
}
