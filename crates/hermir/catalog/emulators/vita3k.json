{
  "id": "vita3k",
  "name": "Vita3K",
  "platforms": [
    "psvita"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "windows": {
      "github": "Vita3K/Vita3K",
      "asset": {
        "name": "windows-latest.zip"
      },
      "exe": "Vita3K.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "Vita3K"
      ]
    }
  },
  "roots": {
    "native": "~/.local/share/Vita3K/Vita3K",
    "portable": "<app>",
    "windows": "%APPDATA%\\Vita3K\\Vita3K"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen}",
      "-r",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "config.yml",
        "format": "yaml"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "key": "boot-apps-full-screen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "key": "resolution-multiplier",
        "scale": {
          "multiplier": {}
        }
      },
      "video.vsync": {
        "file": "main",
        "key": "v-sync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "file": "main",
        "key": "stretch_the_display_area",
        "values": {
          "auto": "false",
          "16:9": "false",
          "stretch": "true"
        }
      },
      "region": {
        "unsupported": "Vita3K has no region setting"
      }
    },
    "players": {
      "automatic": "Vita3K maps SDL pads itself, in the order they appear"
    }
  },
  "saves": {
    "psvita": [
      {
        "kind": "save",
        "path": "ux0/user/00/savedata",
        "per_game": true,
        "note": "per title id (PCSE…)"
      }
    ]
  },
  "notes": "Not on Flathub; the Linux AppImage channel is a later step."
}
