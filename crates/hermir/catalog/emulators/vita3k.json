{
  "id": "vita3k",
  "name": "Vita3K",
  "platforms": [
    "psvita"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "github": "Vita3K/Vita3K",
      "asset": {
        "name": "Vita3K-x86_64.AppImage"
      },
      "exe": "AppRun"
    },
    "windows": {
      "github": "Vita3K/Vita3K",
      "asset": {
        "name": "windows-latest.zip"
      },
      "exe": "Vita3K.exe"
    },
    "macos": {
      "github": "Vita3K/Vita3K",
      "asset": {
        "name": "macos-arm64-latest.dmg"
      },
      "exe": "Vita3K.app/Contents/MacOS/Vita3K"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "Vita3K"
      ]
    },
    "windows": {
      "paths": [
        "%USERPROFILE%\\scoop\\apps\\vita3k\\current\\Vita3K.exe"
      ]
    },
    "macos": {
      "paths": [
        "/Applications/Vita3K.app/Contents/MacOS/Vita3K",
        "~/Applications/Vita3K.app/Contents/MacOS/Vita3K"
      ]
    }
  },
  "roots": {
    "native": "~/.local/share/Vita3K/Vita3K",
    "portable": "<app>",
    "windows": "%APPDATA%\\Vita3K\\Vita3K",
    "macos": "~/Library/Application Support/Vita3K/Vita3K"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen}",
      "-r",
      "{file}"
    ]
  },
  "firmware": {
    "install": {
      "args": [
        "--firmware",
        "{file}"
      ],
      "done": {
        "linux": "vs0/vsh/shell/shell.self",
        "windows": "vs0/vsh/shell/shell.self",
        "macos": "fs/vs0/vsh/shell/shell.self"
      }
    },
    "platforms": {
      "psvita": {
        "any_of": [
          "PSVUPDAT.PUP"
        ],
        "note": "the PlayStation Vita system update, PSVUPDAT.PUP (the font package, PSP2UPDAT.PUP, through Vita3K itself)"
      }
    }
  },
  "config": {
    "files": {
      "main": {
        "path": "config.yml",
        "format": "yaml"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "key": "boot-apps-full-screen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "key": "resolution-multiplier",
        "scale": {
          "multiplier": {}
        },
        "native": [
          960,
          544
        ]
      },
      "video.vsync": {
        "file": "main",
        "key": "v-sync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "file": "main",
        "key": "stretch_the_display_area",
        "values": {
          "auto": "false",
          "16:9": "false",
          "stretch": "true"
        }
      },
      "region": {
        "unsupported": "Vita3K has no region setting"
      }
    },
    "players": {
      "automatic": "Vita3K reads every SDL pad as the one Vita"
    }
  },
  "saves": {
    "psvita": [
      {
        "kind": "save",
        "path": {
          "linux": "ux0/user/00/savedata",
          "windows": "ux0/user/00/savedata",
          "macos": "fs/ux0/user/00/savedata"
        },
        "per_game": true,
        "note": "per title id (PCSE…)",
        "units": {
          "shape": "folders"
        }
      }
    ]
  },
  "content": {
    "psvita": {
      "update": {
        "unsupported": "Vita3K installs a patch package through File → Install .pkg"
      },
      "dlc": {
        "unsupported": "Vita3K installs DLC through File → Install .pkg"
      }
    }
  },
  "notes": "Not on Flathub. Linux and Windows take its continuous build, rebuilt in place under one tag: an update is told by the release's id, not its name."
}
