{
  "id": "ryujinx",
  "name": "Ryujinx",
  "platforms": [
    "switch"
  ],
  "license": "MIT",
  "no_install": "Switch emulators are never installed by hermir. A copy you installed is detected and configured like any other.",
  "detect": {
    "linux": {
      "path": [
        "Ryujinx",
        "ryujinx"
      ],
      "flatpak": "org.ryujinx.Ryujinx"
    },
    "windows": {
      "paths": [
        "%APPDATA%\\Ryujinx\\Ryujinx.exe",
        "%USERPROFILE%\\Ryujinx\\Ryujinx.exe",
        "C:\\Ryujinx\\Ryujinx.exe"
      ],
      "portable_marker": "portable"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.ryujinx.Ryujinx/config/Ryujinx",
    "native": "~/.config/Ryujinx",
    "portable": "<app>/portable",
    "windows": "%APPDATA%\\Ryujinx"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "Config.json",
        "format": "json"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "key": "start_fullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "key": "res_scale",
        "scale": {
          "multiplier": {
            "max": 4
          }
        }
      },
      "video.vsync": {
        "unsupported": "enable_vsync became vsync_mode between versions; pass the one your copy has through native"
      },
      "video.aspect": {
        "file": "main",
        "key": "aspect_ratio",
        "values": {
          "auto": "\"Fixed16x9\"",
          "4:3": "\"Fixed4x3\"",
          "16:9": "\"Fixed16x9\"",
          "stretch": "\"Stretched\""
        }
      },
      "region": {
        "file": "main",
        "key": "system_region",
        "values": {
          "jp": "\"Japan\"",
          "us": "\"USA\"",
          "eu": "\"Europe\""
        }
      }
    },
    "players": {
      "unsupported": "Ryujinx keys pads by its own controller id in Config.json; not yet described"
    }
  },
  "saves": {
    "switch": [
      {
        "kind": "save",
        "path": "bis/user/save",
        "per_game": true,
        "note": "each save under an index of its own, not the title id; Ryujinx maps them in bis/system/save"
      }
    ]
  },
  "notes": "The Ryubing fork keeps the Ryujinx binary and folder names."
}
