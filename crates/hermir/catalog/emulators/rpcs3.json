{
  "id": "rpcs3",
  "name": "RPCS3",
  "platforms": [
    "ps3"
  ],
  "license": "GPL-2.0-only",
  "channels": {
    "linux": {
      "github": "RPCS3/rpcs3-binaries-linux",
      "asset": {
        "all": [
          "linux64",
          ".AppImage"
        ]
      },
      "exe": "AppRun"
    },
    "windows": {
      "github": "RPCS3/rpcs3-binaries-win",
      "asset": {
        "all": [
          "win64",
          ".7z"
        ]
      },
      "exe": "rpcs3.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "rpcs3"
      ],
      "flatpak": "net.rpcs3.RPCS3"
    },
    "windows": {
      "paths": [
        "%LOCALAPPDATA%\\RPCS3\\rpcs3.exe",
        "C:\\RPCS3\\rpcs3.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/net.rpcs3.RPCS3/config/rpcs3",
    "native": "~/.config/rpcs3",
    "portable": "<app>",
    "windows": "<app>"
  },
  "launch": {
    "args": [
      "--no-gui",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": {
          "linux": "config.yml",
          "windows": "config/config.yml"
        },
        "format": "yaml"
      },
      "input": {
        "path": {
          "linux": "input_configs/global/Default.yml",
          "windows": "config/input_configs/global/Default.yml"
        },
        "format": "yaml"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Miscellaneous",
        "key": "Start games in fullscreen mode",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "Video",
        "key": "Resolution Scale",
        "scale": {
          "percent": {}
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "Video",
        "key": "VSync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "Video",
        "key": "Aspect ratio",
        "values": {
          "4:3": "4:3",
          "16:9": "16:9"
        }
      },
      "region": {
        "file": "main",
        "section": "System",
        "key": "License Area",
        "values": {
          "jp": "SCEJ",
          "us": "SCEA",
          "eu": "SCEE"
        }
      }
    },
    "players": {
      "adapter": "rpcs3"
    }
  },
  "notes": "Linux gets RPCS3's own AppImage (x86_64), unpacked: the Flathub build asks on every launch whether to run an unofficial build. Keeps dev_hdd0 and dev_flash beside the exe on Windows, and config.yml, GuiConfigs and input_configs under config/ there. Firmware installs headless with `--installfw <PS3UPDAT.PUP>`; the exit code is not the verdict, dev_flash is.",
  "firmware": {
    "install": {
      "args": [
        "--headless",
        "--installfw",
        "{file}"
      ],
      "done": "dev_flash/vsh/etc/version.txt"
    },
    "platforms": {
      "ps3": {
        "any_of": [
          "PS3UPDAT.PUP"
        ],
        "note": "the PlayStation 3 system update, PS3UPDAT.PUP"
      }
    }
  },
  "first_run": {
    "linux": [
      {
        "ini": "GuiConfigs/CurrentSettings.ini",
        "section": "main_window",
        "key": "infoBoxEnabledWelcome",
        "value": "false"
      }
    ],
    "windows": [
      {
        "ini": "config/GuiConfigs/CurrentSettings.ini",
        "section": "main_window",
        "key": "infoBoxEnabledWelcome",
        "value": "false"
      }
    ]
  }
}
