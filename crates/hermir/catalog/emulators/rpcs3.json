{
  "id": "rpcs3",
  "name": "RPCS3",
  "platforms": [
    "ps3"
  ],
  "license": "GPL-2.0-only",
  "channels": {
    "linux": {
      "github": "RPCS3/rpcs3-binaries-linux",
      "asset": {
        "all": [
          "linux64",
          ".AppImage"
        ]
      },
      "exe": "AppRun"
    },
    "windows": {
      "github": "RPCS3/rpcs3-binaries-win",
      "asset": {
        "all": [
          "win64",
          ".7z"
        ]
      },
      "exe": "rpcs3.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "rpcs3"
      ],
      "flatpak": "net.rpcs3.RPCS3"
    },
    "windows": {
      "paths": [
        "%LOCALAPPDATA%\\RPCS3\\rpcs3.exe",
        "C:\\RPCS3\\rpcs3.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/net.rpcs3.RPCS3/config/rpcs3",
    "native": "~/.config/rpcs3",
    "portable": "<app>",
    "windows": "<app>"
  },
  "launch": {
    "args": [
      "--no-gui",
      "{file}"
    ]
  },
  "notes": "Linux gets RPCS3's own AppImage (x86_64), unpacked: the Flathub build asks on every launch whether to run an unofficial build. Keeps config and dev_hdd0 beside the exe on Windows. Firmware installs headless with `--installfw <PS3UPDAT.PUP>`; the exit code is not the verdict, dev_flash is.",
  "firmware": {
    "install": {
      "args": [
        "--headless",
        "--installfw",
        "{file}"
      ],
      "done": "dev_flash/vsh/etc/version.txt"
    },
    "platforms": {
      "ps3": {
        "any_of": [
          "PS3UPDAT.PUP"
        ],
        "note": "the PlayStation 3 system update, PS3UPDAT.PUP"
      }
    }
  },
  "first_run": {
    "linux": [
      {
        "ini": "GuiConfigs/CurrentSettings.ini",
        "section": "main_window",
        "key": "infoBoxEnabledWelcome",
        "value": "false"
      }
    ],
    "windows": [
      {
        "ini": "GuiConfigs/CurrentSettings.ini",
        "section": "main_window",
        "key": "infoBoxEnabledWelcome",
        "value": "false"
      }
    ]
  }
}
