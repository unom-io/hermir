{
  "id": "melonds",
  "name": "melonDS",
  "platforms": [
    "nds"
  ],
  "license": "GPL-3.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "net.kuribo64.melonDS"
    },
    "windows": {
      "github": "melonDS-emu/melonDS",
      "asset": {
        "all": [
          "windows-x86_64",
          ".zip"
        ]
      },
      "exe": "melonDS.exe",
      "portable": {
        "dir": "portable"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "melonDS"
      ],
      "flatpak": "net.kuribo64.melonDS"
    },
    "windows": {
      "paths": [
        "%USERPROFILE%\\scoop\\apps\\melonds\\current\\melonDS.exe"
      ],
      "portable_marker": "portable"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/net.kuribo64.melonDS/config/melonDS",
    "native": "~/.config/melonDS",
    "portable": "<app>/portable",
    "windows": "%APPDATA%\\melonDS"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "{file}"
    ]
  },
  "firmware": {
    "dir": ".",
    "platforms": {
      "nds": {
        "any_of": [
          "bios7.bin",
          "bios9.bin",
          "firmware.bin"
        ],
        "note": "optional; melonDS also runs without",
        "optional": true,
        "md5": {
          "bios7.bin": [
            "df692a80a5b1bc90728bc3dfc76cd948"
          ],
          "bios9.bin": [
            "a392174eb3e572fed6447e956bde4b25"
          ]
        }
      }
    }
  },
  "config": {
    "files": {
      "main": {
        "path": "melonDS.toml",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "via": "launch"
      },
      "video.scale": {
        "file": "main",
        "section": "3D.GL",
        "key": "ScaleFactor",
        "scale": {
          "multiplier": {
            "max": 16
          }
        },
        "also": [
          {
            "section": "3D",
            "key": "Renderer",
            "value": "1"
          }
        ],
        "note": "selects the OpenGL renderer, the one that scales"
      },
      "video.vsync": {
        "file": "main",
        "section": "Screen",
        "key": "VSync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "unsupported": "two screens; Screen/AspectTop and AspectBot are native keys"
      },
      "region": {
        "unsupported": "DS games are region-free"
      }
    },
    "players": {
      "adapter": "melonds"
    }
  },
  "saves": {
    "nds": [
      {
        "kind": "save",
        "path": "saves",
        "pattern": "*.sav",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "Instance0",
          "key": "SaveFilePath"
        },
        "note": "in its saves folder, which prepare sets unless the player chose one",
        "units": {
          "shape": "files"
        }
      },
      {
        "kind": "state",
        "path": "states",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "Instance0",
          "key": "SavestatePath"
        },
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "notes": "Saves and savestates go beside the ROM by default, which fails on a read-only library: prepare points both into the config root unless the user chose a folder.",
  "first_run": {
    "linux": [
      {
        "dir": "saves"
      },
      {
        "dir": "states"
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SaveFilePath",
        "value": "'{root}/saves'",
        "when_unset": true
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SavestatePath",
        "value": "'{root}/states'",
        "when_unset": true
      }
    ],
    "windows": [
      {
        "dir": "saves"
      },
      {
        "dir": "states"
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SaveFilePath",
        "value": "'{root}/saves'",
        "when_unset": true
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SavestatePath",
        "value": "'{root}/states'",
        "when_unset": true
      }
    ]
  }
}
