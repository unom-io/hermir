{
  "id": "melonds",
  "name": "melonDS",
  "platforms": [
    "nds"
  ],
  "license": "GPL-3.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "net.kuribo64.melonDS"
    },
    "windows": {
      "github": "melonDS-emu/melonDS",
      "asset": {
        "all": [
          "windows-x86_64",
          ".zip"
        ]
      },
      "exe": "melonDS.exe",
      "portable": {
        "dir": "portable"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "melonDS"
      ],
      "flatpak": "net.kuribo64.melonDS"
    },
    "windows": {
      "portable_marker": "portable"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/net.kuribo64.melonDS/config/melonDS",
    "native": "~/.config/melonDS",
    "portable": "<app>/portable",
    "windows": "%APPDATA%\\melonDS"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "{file}"
    ]
  },
  "firmware": {
    "dir": ".",
    "platforms": {
      "nds": {
        "any_of": [
          "bios7.bin",
          "bios9.bin",
          "firmware.bin"
        ],
        "note": "optional; melonDS also runs without",
        "optional": true
      }
    }
  },
  "notes": "Saves and savestates go beside the ROM by default, which fails on a read-only library: prepare points both into the config root unless the user chose a folder.",
  "first_run": {
    "linux": [
      {
        "dir": "saves"
      },
      {
        "dir": "states"
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SaveFilePath",
        "value": "'{root}/saves'",
        "when_unset": true
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SavestatePath",
        "value": "'{root}/states'",
        "when_unset": true
      }
    ],
    "windows": [
      {
        "dir": "saves"
      },
      {
        "dir": "states"
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SaveFilePath",
        "value": "'{root}/saves'",
        "when_unset": true
      },
      {
        "ini": "melonDS.toml",
        "section": "Instance0",
        "key": "SavestatePath",
        "value": "'{root}/states'",
        "when_unset": true
      }
    ]
  }
}
