{
  "id": "cemu",
  "name": "Cemu",
  "platforms": [
    "wiiu"
  ],
  "license": "MPL-2.0",
  "channels": {
    "linux": {
      "flatpak": "info.cemu.Cemu"
    },
    "windows": {
      "github": "cemu-project/Cemu",
      "asset": {
        "all": [
          "windows-x64",
          ".zip"
        ]
      },
      "exe": "Cemu.exe",
      "portable": {
        "dir": "portable"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "Cemu",
        "cemu"
      ],
      "flatpak": "info.cemu.Cemu"
    },
    "windows": {
      "paths": [
        "C:\\Cemu\\Cemu.exe",
        "%LOCALAPPDATA%\\Cemu\\Cemu.exe"
      ],
      "portable_marker": "portable"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/info.cemu.Cemu/config/Cemu",
    "native": "~/.config/Cemu",
    "portable": "<app>/portable",
    "windows": "%APPDATA%\\Cemu"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "-g",
      "{file}"
    ]
  },
  "first_run": {
    "linux": [
      {
        "seed": "settings.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<content/>\n"
      }
    ],
    "windows": [
      {
        "seed": "settings.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<content/>\n"
      }
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "settings.xml",
        "format": "xml",
        "root": "content"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "via": "launch"
      },
      "video.scale": {
        "unsupported": "resolution is a graphic pack in Cemu, enabled per game"
      },
      "video.vsync": {
        "file": "main",
        "section": "Graphic",
        "key": "VSync",
        "bool": [
          "1",
          "0"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "Graphic",
        "key": "FullscreenScaling",
        "values": {
          "auto": "0",
          "16:9": "0",
          "stretch": "1"
        }
      },
      "region": {
        "unsupported": "Cemu takes the region from the title; its global console_region setting is gone"
      }
    },
    "players": {
      "adapter": "cemu"
    }
  },
  "saves": {
    "wiiu": [
      {
        "kind": "save",
        "path": "{data}/mlc01/usr/save/00050000",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "",
          "key": "mlc_path",
          "then": "usr/save/00050000"
        },
        "note": "per title: <low>/user, <low>/meta",
        "units": {
          "shape": "folders"
        }
      }
    ]
  },
  "content": {
    "wiiu": {
      "update": {
        "adapter": "cemu"
      },
      "dlc": {
        "adapter": "cemu"
      }
    }
  }
}
