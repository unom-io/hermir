{
  "id": "duckstation",
  "name": "DuckStation",
  "platforms": [
    "psx"
  ],
  "license": "PolyForm-Strict-1.0.0",
  "archives": true,
  "channels": {
    "linux": {
      "flatpak": "org.duckstation.DuckStation"
    },
    "windows": {
      "github": "stenzek/duckstation",
      "asset": {
        "name": "duckstation-windows-x64-release.zip"
      },
      "exe": "duckstation-qt-x64-ReleaseLTCG.exe",
      "portable": {
        "file": "portable.txt"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "duckstation-qt",
        "duckstation"
      ],
      "flatpak": "org.duckstation.DuckStation"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\DuckStation\\duckstation-qt-x64-ReleaseLTCG.exe"
      ],
      "portable_marker": "portable.txt"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.duckstation.DuckStation/config/duckstation",
    "native": "~/.local/share/duckstation",
    "portable": "<app>",
    "windows": "%USERPROFILE%\\Documents\\DuckStation"
  },
  "launch": {
    "args": [
      "-batch",
      "{fullscreen:-fullscreen}",
      "--",
      "{file}"
    ]
  },
  "firmware": {
    "dir": "bios",
    "platforms": {
      "psx": {
        "any_of": [
          "scph*.bin",
          "*.bin"
        ],
        "note": "a dumped PlayStation BIOS"
      }
    }
  },
  "config": {
    "files": {
      "main": {
        "path": "settings.ini",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Main",
        "key": "StartFullscreen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "GPU",
        "key": "ResolutionScale",
        "scale": {
          "multiplier": {
            "max": 16
          }
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "Display",
        "key": "VSync",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "Display",
        "key": "AspectRatio",
        "values": {
          "auto": "Auto (Game Native)",
          "4:3": "4:3",
          "16:9": "16:9",
          "stretch": "Stretch To Fill"
        }
      },
      "region": {
        "file": "main",
        "section": "Console",
        "key": "Region",
        "values": {
          "auto": "Auto",
          "jp": "NTSC-J",
          "us": "NTSC-U",
          "eu": "PAL"
        }
      },
      "audio.device": {
        "file": "main",
        "section": "Audio",
        "key": "OutputDevice",
        "values": {
          "default": ""
        },
        "text": "{value}"
      },
      "audio.latency_ms": {
        "file": "main",
        "section": "Audio",
        "key": "OutputLatencyMS",
        "text": "{value}",
        "also": [
          {
            "key": "OutputLatencyMinimal",
            "value": "false"
          }
        ]
      }
    },
    "players": {
      "adapter": "duckstation"
    }
  },
  "saves": {
    "psx": [
      {
        "kind": "memcard",
        "path": "memcards",
        "pattern": "*.mcd",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "MemoryCards",
          "key": "Directory"
        },
        "note": "a card per game by default (MemoryCards → Card1Type = PerGameTitle)",
        "units": {
          "shape": "files",
          "shared": [
            "shared_card_?.mcd"
          ]
        }
      },
      {
        "kind": "state",
        "path": "savestates",
        "pattern": "*.sav",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "Folders",
          "key": "SaveStates"
        },
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "notes": "The licence forbids modification and redistribution: hermir installs the official build unchanged. Of its config it writes only the answers to its first-run questions. The first-run seed carries the settings version this release expects (a file without it is reset to defaults, wizard included); bump it with the emulator.",
  "first_run": {
    "linux": [
      {
        "seed": "settings.ini",
        "content": "[Main]\nSettingsVersion = 3\n"
      },
      {
        "ini": "settings.ini",
        "section": "Main",
        "key": "SetupWizardIncomplete",
        "value": "false"
      },
      {
        "ini": "settings.ini",
        "section": "AutoUpdater",
        "key": "CheckAtStartup",
        "value": "false"
      }
    ],
    "windows": [
      {
        "seed": "settings.ini",
        "content": "[Main]\nSettingsVersion = 3\n"
      },
      {
        "ini": "settings.ini",
        "section": "Main",
        "key": "SetupWizardIncomplete",
        "value": "false"
      },
      {
        "ini": "settings.ini",
        "section": "AutoUpdater",
        "key": "CheckAtStartup",
        "value": "false"
      }
    ]
  }
}
