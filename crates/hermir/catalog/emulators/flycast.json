{
  "id": "flycast",
  "name": "Flycast",
  "platforms": [
    "dc"
  ],
  "license": "GPL-2.0-or-later",
  "archives": true,
  "channels": {
    "linux": {
      "flatpak": "org.flycast.Flycast"
    },
    "windows": {
      "github": "flyinghead/flycast",
      "asset": {
        "all": [
          "win64",
          ".zip"
        ]
      },
      "exe": "flycast.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "flycast"
      ],
      "flatpak": "org.flycast.Flycast"
    },
    "windows": {
      "paths": [
        "%USERPROFILE%\\scoop\\apps\\flycast\\current\\flycast.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.flycast.Flycast/config/flycast",
    "native": "~/.config/flycast",
    "portable": "<app>",
    "windows": "%APPDATA%\\flycast"
  },
  "launch": {
    "args": [
      "{fullscreen:-config}",
      "{fullscreen:window:fullscreen=yes}",
      "{file}"
    ]
  },
  "firmware": {
    "dir": "data",
    "platforms": {
      "dc": {
        "any_of": [
          "dc_boot.bin",
          "dc_flash.bin"
        ],
        "note": "optional; Flycast also runs without",
        "optional": true,
        "md5": {
          "dc_boot.bin": [
            "e10c53c2f8b90bab96ead2d368858623"
          ]
        }
      }
    }
  },
  "config": {
    "files": {
      "main": {
        "path": "emu.cfg",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "window",
        "key": "fullscreen",
        "bool": [
          "yes",
          "no"
        ]
      },
      "video.scale": {
        "file": "main",
        "section": "config",
        "key": "rend.Resolution",
        "scale": {
          "lines": {
            "base": 480
          }
        }
      },
      "video.vsync": {
        "file": "main",
        "section": "config",
        "key": "rend.vsync",
        "bool": [
          "yes",
          "no"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "config",
        "key": "rend.WideScreen",
        "values": {
          "auto": "no",
          "4:3": "no",
          "16:9": "yes"
        },
        "note": "16:9 is the widescreen hack"
      },
      "region": {
        "file": "main",
        "section": "config",
        "key": "Dreamcast.Region",
        "values": {
          "auto": "3",
          "jp": "0",
          "us": "1",
          "eu": "2"
        },
        "also": [
          {
            "key": "Dreamcast.Broadcast",
            "values": {
              "auto": "4",
              "jp": "0",
              "us": "0",
              "eu": "1"
            }
          }
        ]
      }
    },
    "players": {
      "adapter": "flycast"
    }
  },
  "saves": {
    "dc": [
      {
        "kind": "memcard",
        "path": "{data}",
        "pattern": "vmu_save_*.bin",
        "note": "a VMU image per port and slot (vmu_save_A1.bin), shared by every game unless per-game VMUs are on",
        "units": {
          "shape": "files",
          "shared": [
            "vmu_save_*.bin"
          ]
        }
      },
      {
        "kind": "state",
        "path": "{data}",
        "pattern": "*.state",
        "per_game": true,
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "notes": "Where a Windows install keeps emu.cfg (beside the exe or under %APPDATA%) is verified when the adapter lands."
}
