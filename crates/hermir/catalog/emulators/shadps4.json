{
  "id": "shadps4",
  "name": "shadPS4",
  "platforms": [
    "ps4"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "github": "shadps4-emu/shadPS4",
      "asset": {
        "all": [
          "shadps4-linux-sdl",
          ".zip"
        ]
      },
      "exe": "AppRun"
    },
    "windows": {
      "github": "shadps4-emu/shadPS4",
      "asset": {
        "all": [
          "shadps4-win64-sdl",
          ".zip"
        ]
      },
      "exe": "shadPS4.exe",
      "portable": {
        "dir": "user"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "shadps4"
      ]
    },
    "windows": {
      "paths": [
        "%USERPROFILE%\\scoop\\apps\\shadps4\\current\\shadPS4.exe"
      ],
      "portable_marker": "user"
    }
  },
  "roots": {
    "native": "~/.local/share/shadPS4",
    "portable": "<app>/user",
    "windows": "%APPDATA%\\shadPS4"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen=true}",
      "-g",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "config.json",
        "format": "json"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "GPU",
        "key": "full_screen",
        "bool": [
          "true",
          "false"
        ],
        "also": [
          {
            "key": "full_screen_mode",
            "bool": [
              "\"Fullscreen\"",
              "\"Windowed\""
            ]
          }
        ]
      },
      "video.scale": {
        "unsupported": "shadPS4 renders at the game's resolution"
      },
      "video.vsync": {
        "unsupported": "shadPS4 paces by GPU/vblank_frequency, a native key"
      },
      "video.aspect": {
        "unsupported": "the game decides"
      },
      "region": {
        "unsupported": "the game decides"
      }
    },
    "players": {
      "automatic": "shadPS4 maps SDL pads itself, in the order they appear"
    }
  },
  "saves": {
    "ps4": [
      {
        "kind": "save",
        "path": "savedata",
        "per_game": true,
        "note": "per user, 1 the first, and game id (CUSA…)",
        "units": {
          "shape": "folders",
          "depth": 2
        }
      }
    ]
  },
  "notes": "The SDL core, not the Qt launcher. It takes the game folder or its eboot.bin. Portable mode keys on a `user` folder in the working directory, not beside the exe. Settings are config.json under the user directory, in General, Input and GPU objects.",
  "firmware": {
    "dir": "sys_modules",
    "platforms": {
      "ps4": {
        "any_of": [
          "*.sprx"
        ],
        "note": "decrypted PS4 system modules (libSce*.sprx), dumped over GoldHEN's FTP",
        "optional": true
      }
    }
  },
  "first_run": {
    "linux": [
      {
        "dir": "home/1000"
      }
    ],
    "windows": [
      {
        "dir": "home/1000"
      }
    ]
  }
}
