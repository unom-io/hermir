{
  "id": "supermodel",
  "name": "Supermodel",
  "platforms": [
    "model3"
  ],
  "license": "GPL-3.0-or-later",
  "channels": {
    "linux": {
      "github": "trzy/Supermodel",
      "asset": {
        "all": [
          "supermodel-",
          "-linux.tar.gz"
        ]
      },
      "exe": "supermodel"
    },
    "windows": {
      "github": "trzy/Supermodel",
      "asset": {
        "all": [
          "supermodel-",
          "-windows.zip"
        ]
      },
      "exe": "supermodel.exe",
      "portable": {
        "dir": "Config"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "supermodel"
      ],
      "flatpak": "com.supermodel3.Supermodel"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/com.supermodel3.Supermodel/config/supermodel",
    "native": "~/.supermodel",
    "portable": "<app>",
    "windows": "<app>"
  },
  "launch": {
    "args": [
      "{file}",
      "{fullscreen:-fullscreen}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "Config/Supermodel.ini",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Global",
        "key": "FullScreen",
        "bool": [
          "1",
          "0"
        ]
      },
      "video.scale": {
        "unsupported": "renders at XResolution × YResolution; set them through native"
      },
      "video.vsync": {
        "file": "main",
        "section": "Global",
        "key": "VSync",
        "bool": [
          "1",
          "0"
        ]
      },
      "video.aspect": {
        "file": "main",
        "section": "Global",
        "key": "WideScreen",
        "values": {
          "auto": "0",
          "4:3": "0",
          "16:9": "1"
        }
      },
      "region": {
        "unsupported": "the ROM set decides"
      }
    },
    "players": {
      "adapter": "supermodel"
    }
  },
  "saves": {
    "model3": [
      {
        "kind": "save",
        "path": "{data}/NVRAM",
        "pattern": "*.nv",
        "per_game": true,
        "note": "each game's backup RAM"
      },
      {
        "kind": "state",
        "path": "{data}/Saves",
        "pattern": "*.st?",
        "per_game": true
      }
    ]
  },
  "notes": "SDL2 + OpenGL through GLX: it needs X11 or XWayland, not a Wayland socket. With `~/.supermodel` present it keeps Config, NVRAM, Saves and Assets in there; without Games.xml and the crosshair bitmaps it exits. A ROM set is a MAME-style zip, its parent set beside it.",
  "first_run": {
    "linux": [
      {
        "copy": "Config/Games.xml",
        "to": "Config/Games.xml"
      },
      {
        "copy": "Config/Music.xml",
        "to": "Config/Music.xml"
      },
      {
        "copy": "Assets/p1crosshair.bmp",
        "to": "Assets/p1crosshair.bmp"
      },
      {
        "copy": "Assets/p2crosshair.bmp",
        "to": "Assets/p2crosshair.bmp"
      },
      {
        "dir": "NVRAM"
      },
      {
        "dir": "Saves"
      }
    ]
  }
}
