{
  "id": "retroarch",
  "name": "RetroArch",
  "platforms": [
    "nes",
    "fds",
    "snes",
    "n64",
    "gb",
    "gbc",
    "gba",
    "nds",
    "psx",
    "psp",
    "genesis",
    "sms",
    "gamegear",
    "segacd",
    "sega32x",
    "saturn",
    "dc",
    "tg16",
    "ngp",
    "wonderswan",
    "lynx",
    "atari2600",
    "atari7800",
    "jaguar",
    "3do",
    "arcade",
    "c64",
    "amiga",
    "msx",
    "zxspectrum",
    "dos",
    "virtualboy",
    "vectrex",
    "colecovision",
    "ngc",
    "wii",
    "scummvm"
  ],
  "license": "GPL-3.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.libretro.RetroArch"
    },
    "windows": {
      "url": "https://buildbot.libretro.com/stable/1.22.2/windows/x86_64/RetroArch.7z",
      "version": "1.22.2",
      "sha256": "b2139b1d0f9d4526dc6b5ce23cbb3efdc766096fa6f2c3df016818b486ac6372",
      "exe": "retroarch.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "retroarch"
      ],
      "flatpak": "org.libretro.RetroArch"
    },
    "windows": {
      "paths": [
        "%APPDATA%\\RetroArch\\retroarch.exe",
        "C:\\RetroArch-Win64\\retroarch.exe",
        "C:\\RetroArch\\retroarch.exe"
      ],
      "portable_marker": "retroarch.cfg"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.libretro.RetroArch/config/retroarch",
    "native": "~/.config/retroarch",
    "portable": "<app>",
    "windows": "%APPDATA%\\RetroArch"
  },
  "launch": {
    "args": [
      "{fullscreen:-f}",
      "-L",
      "{core}",
      "{file}"
    ],
    "cores": {
      "nes": "mesen",
      "fds": "mesen",
      "snes": "snes9x",
      "n64": "mupen64plus_next",
      "gb": "gambatte",
      "gbc": "gambatte",
      "gba": "mgba",
      "nds": "melondsds",
      "psx": "swanstation",
      "psp": "ppsspp",
      "genesis": "genesis_plus_gx",
      "sms": "genesis_plus_gx",
      "gamegear": "genesis_plus_gx",
      "segacd": "genesis_plus_gx",
      "sega32x": "picodrive",
      "saturn": "mednafen_saturn",
      "dc": "flycast",
      "tg16": "mednafen_pce",
      "ngp": "mednafen_ngp",
      "wonderswan": "mednafen_wswan",
      "lynx": "handy",
      "atari2600": "stella",
      "atari7800": "prosystem",
      "jaguar": "virtualjaguar",
      "3do": "opera",
      "arcade": "fbneo",
      "c64": "vice_x64sc",
      "amiga": "puae",
      "msx": "bluemsx",
      "zxspectrum": "fuse",
      "dos": "dosbox_pure",
      "virtualboy": "mednafen_vb",
      "vectrex": "vecx",
      "colecovision": "gearcoleco",
      "ngc": "dolphin",
      "wii": "dolphin",
      "scummvm": "scummvm"
    }
  },
  "firmware": {
    "dir": "system",
    "platforms": {
      "psx": {
        "any_of": [
          "scph*.bin"
        ],
        "note": "a dumped PlayStation BIOS"
      },
      "saturn": {
        "any_of": [
          "sega_101.bin",
          "mpr-17933.bin"
        ]
      },
      "segacd": {
        "any_of": [
          "bios_CD_*.bin"
        ]
      },
      "nds": {
        "any_of": [
          "bios7.bin",
          "bios9.bin",
          "firmware.bin"
        ],
        "note": "optional",
        "optional": true
      },
      "gba": {
        "any_of": [
          "gba_bios.bin"
        ],
        "note": "optional",
        "optional": true
      },
      "tg16": {
        "any_of": [
          "syscard3.pce"
        ],
        "note": "for CD games"
      },
      "3do": {
        "any_of": [
          "panafz10.bin"
        ]
      },
      "lynx": {
        "any_of": [
          "lynxboot.img"
        ]
      },
      "dc": {
        "any_of": [
          "dc/dc_boot.bin",
          "dc/dc_flash.bin"
        ],
        "note": "optional",
        "optional": true
      }
    }
  },
  "config": {
    "files": {
      "main": {
        "path": "retroarch.cfg",
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "key": "video_fullscreen",
        "bool": [
          "\"true\"",
          "\"false\""
        ]
      },
      "video.scale": {
        "unsupported": "internal resolution is a core option, per core"
      },
      "video.vsync": {
        "file": "main",
        "key": "video_vsync",
        "bool": [
          "\"true\"",
          "\"false\""
        ]
      },
      "video.aspect": {
        "file": "main",
        "key": "aspect_ratio_index",
        "values": {
          "auto": "\"22\"",
          "4:3": "\"0\"",
          "16:9": "\"1\"",
          "stretch": "\"24\""
        }
      },
      "region": {
        "unsupported": "a core option, per core"
      },
      "audio.device": {
        "file": "main",
        "key": "audio_device",
        "values": {
          "default": "\"\""
        },
        "text": "\"{value}\""
      },
      "audio.latency_ms": {
        "file": "main",
        "key": "audio_latency",
        "text": "\"{value}\""
      }
    },
    "players": {
      "adapter": "retroarch"
    }
  },
  "profile": {
    "args": [
      "-c",
      "{profile}/retroarch.cfg"
    ],
    "files": {
      "main": "retroarch.cfg"
    },
    "note": "cores, autoconfig profiles and saves stay where the player's own config points"
  },
  "saves": {
    "*": [
      {
        "kind": "save",
        "path": "saves",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "",
          "key": "savefile_directory",
          "unset": [
            "default"
          ]
        },
        "note": "in a folder per core (sort_savefiles_enable, on by default), or per content folder; each core names its files"
      },
      {
        "kind": "state",
        "path": "states",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "",
          "key": "savestate_directory",
          "unset": [
            "default"
          ]
        },
        "note": "in a folder per core (sort_savestates_enable, on by default), or per content folder"
      }
    ]
  },
  "notes": "Cores come from the buildbot through `hermir core install <core>`; the Windows 7z is portable as shipped."
}
