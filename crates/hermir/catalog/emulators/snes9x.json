{
  "id": "snes9x",
  "name": "Snes9x",
  "platforms": [
    "snes"
  ],
  "license": "LicenseRef-Snes9x",
  "channels": {
    "linux": {
      "flatpak": "com.snes9x.Snes9x"
    },
    "windows": {
      "github": "snes9xgit/snes9x",
      "asset": {
        "all": [
          "win32-x64",
          ".zip"
        ]
      },
      "exe": "snes9x-x64.exe"
    }
  },
  "detect": {
    "linux": {
      "path": [
        "snes9x-gtk",
        "snes9x"
      ],
      "flatpak": "com.snes9x.Snes9x"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\Snes9x\\snes9x-x64.exe",
        "C:\\snes9x\\snes9x-x64.exe"
      ]
    }
  },
  "roots": {
    "flatpak": "~/.var/app/com.snes9x.Snes9x/config/snes9x",
    "native": "~/.config/snes9x",
    "portable": "<app>",
    "windows": "<app>"
  },
  "launch": {
    "args": [
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": {
          "linux": "snes9x.conf"
        },
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Display",
        "key": "FullscreenOnOpen",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.scale": {
        "unsupported": "a 2D console; Snes9x scales the picture to the window"
      },
      "video.vsync": {
        "file": "main",
        "section": "OpenGL",
        "key": "VSync",
        "bool": [
          "true",
          "false"
        ],
        "note": "the OpenGL output's, the default one; Vulkan keeps its own"
      },
      "video.aspect": {
        "file": "main",
        "section": "Display",
        "key": "AspectRatio",
        "values": {
          "auto": "4",
          "4:3": "2",
          "stretch": "2"
        },
        "also": [
          {
            "key": "MaintainAspectRatio",
            "values": {
              "auto": "true",
              "4:3": "true",
              "stretch": "false"
            }
          }
        ]
      },
      "region": {
        "unsupported": "the cartridge's header decides"
      },
      "audio.latency_ms": {
        "file": "main",
        "section": "Sound",
        "key": "BufferSize",
        "text": "{value}"
      }
    },
    "players": {
      "adapter": "snes9x"
    }
  },
  "saves": {
    "snes": [
      {
        "kind": "save",
        "path": {
          "linux": "{game}",
          "windows": "Saves"
        },
        "pattern": "*.srm",
        "per_game": true,
        "note": "beside each game on Linux unless SRAMDirectory is set; Saves/ beside the exe on Windows",
        "setting": {
          "file": "main",
          "section": "Files",
          "key": "SRAMDirectory"
        },
        "units": {
          "shape": "files"
        }
      },
      {
        "kind": "state",
        "path": {
          "linux": "{game}",
          "windows": "Saves"
        },
        "pattern": "*.00?",
        "per_game": true,
        "note": "beside each game on Linux unless SaveStateDirectory is set",
        "setting": {
          "file": "main",
          "section": "Files",
          "key": "SaveStateDirectory"
        },
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "notes": "The Windows build keeps snes9x.conf beside its exe; the GTK build under ~/.config/snes9x. Its licence is Snes9x's own, non-commercial."
}
