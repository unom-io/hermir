{
  "id": "dolphin",
  "name": "Dolphin",
  "platforms": [
    "ngc",
    "wii"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.DolphinEmu.dolphin-emu"
    },
    "windows": {
      "url": "https://dl.dolphin-emu.org/releases/2609/dolphin-2609-x64.7z",
      "version": "2609",
      "sha256": "1aa25785b7d4cb76259754c5fbcdd8856857b8e7bb4e523c57a8ac56665fba75",
      "exe": "Dolphin.exe",
      "portable": {
        "file": "portable.txt"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "dolphin-emu"
      ],
      "flatpak": "org.DolphinEmu.dolphin-emu"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\Dolphin-x64\\Dolphin.exe"
      ],
      "portable_marker": "portable.txt"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu",
    "native": "~/.config/dolphin-emu",
    "portable": "<app>/User",
    "windows": "%USERPROFILE%\\Documents\\Dolphin Emulator"
  },
  "launch": {
    "args": [
      "-b",
      "-e",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": {
          "linux": "Dolphin.ini",
          "windows": "Config/Dolphin.ini"
        },
        "format": "ini",
        "case_insensitive": true
      },
      "gfx": {
        "path": {
          "linux": "GFX.ini",
          "windows": "Config/GFX.ini"
        },
        "format": "ini",
        "case_insensitive": true
      },
      "gcpad": {
        "path": {
          "linux": "GCPadNew.ini",
          "windows": "Config/GCPadNew.ini"
        },
        "format": "ini",
        "case_insensitive": true
      },
      "wiimote": {
        "path": {
          "linux": "WiimoteNew.ini",
          "windows": "Config/WiimoteNew.ini"
        },
        "format": "ini",
        "case_insensitive": true
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Display",
        "key": "Fullscreen",
        "bool": [
          "True",
          "False"
        ]
      },
      "video.scale": {
        "file": "gfx",
        "section": "Settings",
        "key": "InternalResolution",
        "scale": {
          "multiplier": {}
        }
      },
      "video.vsync": {
        "file": "gfx",
        "section": "Hardware",
        "key": "VSync",
        "bool": [
          "True",
          "False"
        ]
      },
      "video.aspect": {
        "file": "gfx",
        "section": "Settings",
        "key": "AspectRatio",
        "values": {
          "auto": "0",
          "16:9": "1",
          "4:3": "2",
          "stretch": "3"
        }
      },
      "region": {
        "unsupported": "the disc decides; Dolphin's FallbackRegion applies to region-free titles only"
      }
    },
    "players": {
      "adapter": "dolphin"
    }
  },
  "profile": {
    "args": [
      "-u",
      "{profile}"
    ],
    "files": {
      "main": "Config/Dolphin.ini",
      "gfx": "Config/GFX.ini",
      "gcpad": "Config/GCPadNew.ini",
      "wiimote": "Config/WiimoteNew.ini"
    },
    "note": "with -u Dolphin keeps everything in the profile, its Wii NAND and GameCube memory cards (the saves) included"
  },
  "saves": {
    "ngc": [
      {
        "kind": "memcard",
        "path": "{data}/GC",
        "note": "a card file per region and slot (MemoryCardA.USA.raw), or a GCI folder per region and slot (USA/Card A), whichever the slot is set to",
        "units": {
          "shape": "files",
          "shared": [
            "*/Card ?.raw",
            "*/MemoryCard?.*.raw",
            "MemoryCard?.*.raw"
          ]
        }
      },
      {
        "kind": "state",
        "path": "{data}/StateSaves",
        "pattern": "*.s??",
        "per_game": true,
        "units": {
          "shape": "files"
        }
      }
    ],
    "wii": [
      {
        "kind": "save",
        "path": "{data}/Wii/title/00010000",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "General",
          "key": "NANDRootPath",
          "then": "title/00010000"
        },
        "note": "each disc game's data under its title id: <id>/data",
        "units": {
          "shape": "folders"
        }
      },
      {
        "kind": "save",
        "path": "{data}/Wii/title/00010004",
        "per_game": true,
        "setting": {
          "file": "main",
          "section": "General",
          "key": "NANDRootPath",
          "then": "title/00010004"
        },
        "note": "the channel a disc game installs (Mario Kart Wii, Wii Fit)",
        "units": {
          "shape": "folders",
          "under": "00010004"
        }
      },
      {
        "kind": "state",
        "path": "{data}/StateSaves",
        "pattern": "*.s??",
        "per_game": true,
        "units": {
          "shape": "files"
        }
      }
    ]
  },
  "content": {
    "wii": {
      "update": {
        "unsupported": "a Wii game takes no update; WiiWare DLC installs through Tools → Install WAD"
      },
      "dlc": {
        "unsupported": "Dolphin installs DLC through Tools → Install WAD to the NAND"
      }
    }
  },
  "notes": "No GitHub releases; the URL is bumped by catalog PRs. `-u <dir>` selects a user directory for profiles.",
  "first_run": {
    "linux": [
      {
        "ini": "Dolphin.ini",
        "section": "Analytics",
        "key": "PermissionAsked",
        "value": "True"
      }
    ],
    "windows": [
      {
        "ini": "Config/Dolphin.ini",
        "section": "Analytics",
        "key": "PermissionAsked",
        "value": "True"
      }
    ]
  }
}
