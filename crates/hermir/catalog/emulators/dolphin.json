{
  "id": "dolphin",
  "name": "Dolphin",
  "platforms": [
    "ngc",
    "wii"
  ],
  "license": "GPL-2.0-or-later",
  "channels": {
    "linux": {
      "flatpak": "org.DolphinEmu.dolphin-emu"
    },
    "windows": {
      "url": "https://dl.dolphin-emu.org/releases/2609/dolphin-2609-x64.7z",
      "version": "2609",
      "sha256": "1aa25785b7d4cb76259754c5fbcdd8856857b8e7bb4e523c57a8ac56665fba75",
      "exe": "Dolphin.exe",
      "portable": {
        "file": "portable.txt"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "dolphin-emu"
      ],
      "flatpak": "org.DolphinEmu.dolphin-emu"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\Dolphin-x64\\Dolphin.exe"
      ],
      "portable_marker": "portable.txt"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu",
    "native": "~/.config/dolphin-emu",
    "portable": "<app>/User",
    "windows": "%USERPROFILE%\\Documents\\Dolphin Emulator"
  },
  "launch": {
    "args": [
      "-b",
      "-e",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": {
          "linux": "Dolphin.ini",
          "windows": "Config/Dolphin.ini"
        },
        "format": "ini"
      },
      "gfx": {
        "path": {
          "linux": "GFX.ini",
          "windows": "Config/GFX.ini"
        },
        "format": "ini"
      },
      "gcpad": {
        "path": {
          "linux": "GCPadNew.ini",
          "windows": "Config/GCPadNew.ini"
        },
        "format": "ini"
      },
      "wiimote": {
        "path": {
          "linux": "WiimoteNew.ini",
          "windows": "Config/WiimoteNew.ini"
        },
        "format": "ini"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "file": "main",
        "section": "Display",
        "key": "Fullscreen",
        "bool": [
          "True",
          "False"
        ]
      },
      "video.scale": {
        "file": "gfx",
        "section": "Settings",
        "key": "InternalResolution",
        "scale": {
          "multiplier": {}
        }
      },
      "video.vsync": {
        "file": "gfx",
        "section": "Hardware",
        "key": "VSync",
        "bool": [
          "True",
          "False"
        ]
      },
      "video.aspect": {
        "file": "gfx",
        "section": "Settings",
        "key": "AspectRatio",
        "values": {
          "auto": "0",
          "16:9": "1",
          "4:3": "2",
          "stretch": "3"
        }
      },
      "region": {
        "unsupported": "the disc decides; Dolphin's FallbackRegion applies to region-free titles only"
      }
    },
    "players": {
      "adapter": "dolphin"
    }
  },
  "notes": "No GitHub releases; the URL is bumped by catalog PRs. `-u <dir>` selects a user directory for profiles.",
  "first_run": {
    "linux": [
      {
        "ini": "Dolphin.ini",
        "section": "Analytics",
        "key": "PermissionAsked",
        "value": "True"
      }
    ],
    "windows": [
      {
        "ini": "Config/Dolphin.ini",
        "section": "Analytics",
        "key": "PermissionAsked",
        "value": "True"
      }
    ]
  }
}
