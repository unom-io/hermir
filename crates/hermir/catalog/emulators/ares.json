{
  "id": "ares",
  "name": "ares",
  "platforms": [
    "nes",
    "fds",
    "snes",
    "n64",
    "gb",
    "gbc",
    "gba",
    "genesis",
    "sms",
    "gamegear",
    "segacd",
    "sega32x",
    "psx",
    "tg16",
    "ngp",
    "wonderswan",
    "msx",
    "colecovision",
    "atari2600"
  ],
  "license": "ISC",
  "channels": {
    "linux": {
      "flatpak": "dev.ares.ares"
    },
    "windows": {
      "github": "ares-emulator/ares",
      "asset": {
        "all": [
          "windows",
          ".zip"
        ],
        "none": [
          "arm64",
          "debug",
          "pdb",
          "symbols"
        ]
      },
      "exe": "ares.exe",
      "portable": {
        "file": "settings.bml"
      }
    }
  },
  "detect": {
    "linux": {
      "path": [
        "ares"
      ],
      "flatpak": "dev.ares.ares"
    },
    "windows": {
      "paths": [
        "%ProgramFiles%\\ares\\ares.exe",
        "%LOCALAPPDATA%\\Programs\\ares\\ares.exe"
      ],
      "portable_marker": "settings.bml"
    }
  },
  "roots": {
    "flatpak": "~/.var/app/dev.ares.ares/data/ares",
    "native": "~/.local/share/ares",
    "portable": "<app>",
    "windows": "%LOCALAPPDATA%\\ares"
  },
  "launch": {
    "args": [
      "{fullscreen:--fullscreen}",
      "{file}"
    ]
  },
  "config": {
    "files": {
      "main": {
        "path": "settings.bml",
        "format": "bml"
      }
    },
    "knobs": {
      "video.fullscreen": {
        "via": "launch"
      },
      "video.scale": {
        "unsupported": "per system in ares (Nintendo 64 quality and supersampling); pass them through native"
      },
      "video.vsync": {
        "file": "main",
        "section": "Video",
        "key": "Blocking",
        "bool": [
          "true",
          "false"
        ]
      },
      "video.aspect": {
        "unsupported": "Video/AspectCorrectionMode and Video/Output are native keys"
      },
      "region": {
        "file": "main",
        "section": "Boot",
        "key": "Prefer",
        "values": {
          "jp": "NTSC-J",
          "us": "NTSC-U",
          "eu": "PAL"
        }
      }
    },
    "players": {
      "unsupported": "ares binds pads by its own device ids in settings.bml; not yet described"
    }
  },
  "notes": "One emulator for most cartridge-era systems; `--system <name>` picks one when a file is ambiguous. Settings live in settings.bml beside the exe when that file exists (the managed install places it), else under the user's data directory (~/.local/share/ares, %LOCALAPPDATA%\\ares). The release assets are ares-windows-x64.zip and the arm64 and PDB zips beside it."
}
